# questail-collie 환경변수 샘플
# 사용법: cp .env.example .env  후 필요한 값만 채운다.
# 저장소 루트 .env가 전역 ~/.config/questail/.env를 덮어쓴다.
# OpenAI 호환 엔드포인트면 어디든 된다.

# (a) 기본 - 원격 (키 필요). base URL·모델은 기본값이라 생략해도 된다.
QUESTAIL_LLM_API_KEY=
QUESTAIL_LLM_BASE_URL=https://opencode.ai/zen/go/v1
QUESTAIL_LLM_MODEL=mimo-v2.5

# (b) 대체 - 로컬 Ollama (키 불필요). 쓸 때만 주석을 풀고 (a) 대신 둔다.
# QUESTAIL_LLM_BASE_URL=http://localhost:11434/v1
# QUESTAIL_LLM_MODEL=qwen3:8b

# 데모 서버 포트 (기본 3000). 바꿀 때만 주석을 푼다.
# PORT=3000
